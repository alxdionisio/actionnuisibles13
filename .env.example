# Formspree : créez un formulaire sur https://formspree.io, puis copiez l’ID du formulaire ici.
# L’ID se trouve dans l’URL après /f/ (ex. https://formspree.io/f/xyzabcd → xyzabcd)
# Optionnel : par défaut le formulaire mvzbkezg est utilisé. Définir pour en utiliser un autre.
# VITE_FORMSPREE_FORM_ID=mvzbkezg

# URL canonique du site (recommandé en production pour des canonicals cohérents avec Google).
# Ex. https://www.actionnuisibles13.com (sans slash final). Utilisé pour <link rel="canonical"> et og:url.
# VITE_SITE_URL=https://www.actionnuisibles13.com

# Base path Vite (slash final recommandé pour un sous-dossier, ex. /mon-repo/).
# En local : défaut /. Sur GitHub Actions, le workflow choisit automatiquement « / » si public/CNAME
# existe (domaine personnalisé), sinon /{nom-du-repo}/ pour github.io/<user>/<repo>/.
# Pour forcer : variable de dépôt VITE_BASE_PATH (prioritaire) ou VITE_BASE_URL.
# VITE_BASE_PATH=/

# ─── Frontend (Vite — exposées au navigateur, peuvent être committées) ──
  VITE_FORMSPREE_FORM_ID=
  VITE_SITE_URL=https://www.actionnuisibles13.com

  # ─── Backend — Environnement ────────────────────────────────────────────
  NODE_ENV=production

  # ─── Sessions (OBLIGATOIRE en prod, fail-fast sinon) ────────────────────
  # Génère avec : openssl rand -hex 48
  SESSION_SECRET=
  
  # ─── Compte admin initial ──────────────────────────────────────────────
  # Si vide ET DB vide → un mdp aléatoire est loggé UNE SEULE fois au démarrage
  ADMIN_USERNAME=
  ADMIN_PASSWORD=
  ADMIN_EMAIL=

  # ─── URL publique du back-office (liens dans les emails de reset) ──────
  PUBLIC_URL=https://admin.actionnuisibles13.com

  # ─── CORS pour le front-office ──────────────────────────────────────────
  ALLOWED_ORIGINS=https://www.actionnuisibles13.com,https://actionnuisibles13.co
  m

  # ─── Stockage Railway (volume monté) ───────────────────────────────────
  DATA_DIR=/data

  # ─── SMTP Resend (https://resend.com — 3000 emails/mois gratuits) ──────
  # Crée une API key avec scope "Sending access" sur ton domaine vérifié
  SMTP_HOST=smtp.resend.com
  SMTP_PORT=465
  SMTP_USER=resend
  SMTP_PASS=
  SMTP_FROM=no-reply@actionnuisibles13.com
  SMTP_FROM_NAME=Action Nuisibles 13